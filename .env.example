# --- Database ---
# Host port is 55432 (not 5432) to avoid clashing with a locally-installed Postgres.
POSTGRES_USER=abms
POSTGRES_PASSWORD=change-me
POSTGRES_DB=abms
DATABASE_URL=postgresql://abms:change-me@localhost:55432/abms?schema=public

# --- API ---
API_PORT=4000
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TIMEOUT_MINS=120
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# --- File storage (MinIO, S3-compatible) ---
STORAGE_DRIVER=local
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=abms-storage
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=abms-files
MINIO_USE_SSL=false

# --- Web ---
VITE_API_URL=http://localhost:4000/graphql
WEB_APP_URL=http://localhost:5173

# --- Email (invite + password reset links) ---
# Local dev: points at the mailpit container from docker-compose.dev.yml —
# view sent emails at http://localhost:8025. Set real SMTP creds for prod.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ABMS <no-reply@abms.local>"

# --- Org bootstrap (used by db:seed) ---
SEED_ORG_NAME="Demo Company"
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
