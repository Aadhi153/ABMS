# syntax=docker/dockerfile:1
FROM node:20-alpine AS base
RUN corepack enable
WORKDIR /repo

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* turbo.json tsconfig.base.json ./
COPY packages/database/package.json packages/database/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/config/package.json packages/config/package.json
COPY apps/api/package.json apps/api/package.json
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY packages/database packages/database
COPY packages/shared packages/shared
COPY packages/config packages/config
COPY apps/api apps/api
RUN pnpm --filter @abms/database db:generate
RUN pnpm --filter @abms/api build

FROM base AS runtime
ENV NODE_ENV=production
COPY --from=build /repo/package.json /repo/pnpm-workspace.yaml /repo/pnpm-lock.yaml* ./
COPY --from=build /repo/packages/database/package.json packages/database/package.json
COPY --from=build /repo/packages/shared/package.json packages/shared/package.json
COPY --from=build /repo/apps/api/package.json apps/api/package.json
RUN pnpm install --frozen-lockfile --prod
COPY --from=build /repo/packages/database/generated packages/database/generated
COPY --from=build /repo/packages/shared/src packages/shared/src
COPY --from=build /repo/apps/api/dist apps/api/dist

WORKDIR /repo/apps/api
EXPOSE 4000
CMD ["node", "dist/main.js"]
